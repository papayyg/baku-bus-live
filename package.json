{
    "name": "baku-bus-live",
    "version": "1.0.0",
    "description": "Live arrivals of Baku city buses — a Telegram bot and Mini App.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch server/index.ts",
        "dev:web": "vite --config web/vite.config.ts",
        "build": "vite build --config web/vite.config.ts",
        "start": "bun run server/index.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
        "lint": "biome check .",
        "format": "biome check --write ."
    },
    "dependencies": {
        "@grammyjs/auto-retry": "2.0.2",
        "@grammyjs/runner": "2.0.3",
        "grammy": "1.46.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@fontsource-variable/inter": "5.3.0",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-query": "5.105.0",
        "@twa-dev/types": "8.0.2",
        "@types/bun": "1.4.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "country-flag-emoji-polyfill": "0.1.10",
        "lucide-react": "1.64.0",
        "maplibre-gl": "6.16.0",
        "motion": "14.7.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "zustand": "5.0.16"
    }
}
