# Telegram bot token
BOT_TOKEN=

# Public HTTPS URL of the Mini App
PUBLIC_URL=https://example.com

# AYNA MaaS gateway
NECPT_URL=https://service.necpt.xyz/api/index.php
NECPT_TOKEN=
NECPT_APP_VERSION=V4.0.5

# AYNA map API: stops and routes
AYNA_API_URL=https://map-api.ayna.gov.az

LOG_LEVEL=info

# Run the API and Mini App without the bot
BOT_DISABLED=false

# Development only: requests without Telegram auth act as this user
# DEV_USER_ID=1

# Docker Compose host port
# APP_PORT=8080
